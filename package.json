{
  "name": "modworld-specs",
  "version": "0.1.0",
  "private": true,
  "description": "ModWorld: design specs and cages in the root, the playable client in game/, the shared math in engine/.",
  "scripts": {
    "verify": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/verify.ts",
    "wiki": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/wiki.ts build",
    "skills": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/skills.ts",
    "tree": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/tree.ts",
    "map": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/map.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "npm --prefix game run dev",
    "build": "npm --prefix game run build",
    "test": "npm --prefix game run test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3"
  }
}
