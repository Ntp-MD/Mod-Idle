  "meta": {
    "note": "Skill roster source of truth. tools/skills.ts --write regenerates the roster tables in skill-pool*.md; --checks runs the mechanic gate (checks.md D18). Edit here, never hand-edit between the GENERATED markers.",
    "types": [
      "attack",
      "buff",
      "curse",
      "heal",
      "aura"
    ],
    "type_meta": {
      "attack": "Order list · cd + mana",
      "buff": "Timed self-buff - own cd and duration, never persists between fights",
      "curse": "Attached to target · Uses same hit_chance as attacks",
      "heal": "Same list (key on bosses)",
      "aura": "Player-managed set · **Reserves Max Mana**"
    },
    "weapon_groups": [
      "melee",
      "ranged",
      "magic"
    ],
    "elements": [
      "physical",
      "fire",
      "cold",
      "lightning",
