      "chaos"
    ],
    "reservation": {
      "max_pct": 100,
      "note": "The player opens auras; the only system rule is that total reserved mana may not reach 100% of the pool — some mana must stay usable for skills. There is no other cap."
    },
    "formula": {
      "level_step_pct": 1.5,
      "mana_level_step_pct": 5,
      "mana_pool_exponent": 0.5,
      "mana_reference_level": 1,
      "cast_reference": {
        "cdr_pct": 50,
        "ladder_pct": 30
      },
      "note": "press = final_pct × basis × (1 + (skill_level − 1) × level_step_pct/100) · basis phys = the caster's finished physical hit · basis magic = their magic + Element × Alignment/100 (B5). `final_pct` is the level-1 fraction, so a fresh skill presses exactly what its row states. Read by tools/lib/skillmodel.ts for the --calc workshop, the attack-table press column and the client's casts. A mana cost is written in one of two forms and the unit is part of it: `N%` charges N% of the usable pool, `N flat` charges N absolute units. A flat cost is the price at skill level 1 and grows on `mana_level_step_pct` per skill level, steeper than the damage ramp so a maxed rotation costs more, and on `(pool / reference pool)^mana_pool_exponent`, so Int and Max Mana gear still set the price. The reference pool is derived at `mana_reference_level`, never typed here."
    }
  },
