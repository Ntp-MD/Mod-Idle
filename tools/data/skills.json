{
  "meta": {
    "note": "The roster source of truth and the only home of a skill number. engine/skills.ts is the one calculator and the client calls the same function, so a press is never typed twice. tools/skills.ts --calc prints the workshop; --checks runs the mechanic gate.",
    "types": [
      "attack",
      "buff",
      "curse",
      "heal",
      "aura"
    ],
    "type_meta": {
      "attack": "Order list · cd + mana",
      "buff": "Timed self-buff - own cd and duration, never persists between fights",
      "curse": "Attached to target · Uses same hit_chance as attacks",
      "heal": "Same list (key on bosses)",
      "aura": "Player-managed set · **Reserves Max Mana**"
    },
    "weapon_groups": [
      "melee",
      "ranged",
      "magic"
    ],
    "elements": [
      "physical",
      "fire",
