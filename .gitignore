# Installed dependencies and build output for the client
node_modules/
game/dist/

# Resumable release-journey checkpoints are local measurement state, not source
game/.cache/release-journey/
game/.cache/measurement-build/

# Generated tool previews and reports (shader baking, Playwright captures)
output/
game/test-results/

# Python bytecode generated by local art tools
__pycache__/
*.py[cod]

# Local secrets and environment files
.env
.env.*
!.env.example

# Retired game art/data snapshots, kept locally only
archive/
.playwright-mcp/
.cache

# Generated VFX review snapshots stay local; review live in playground.html
docs/vfx-skill/component-vfx/evidence/captures/
