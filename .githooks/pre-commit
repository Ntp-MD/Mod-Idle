#!/bin/sh
# ModWorld pre-commit: run every cage (the doc linter is inside them: L9 prose numbers, L10 doc
# pointers, X59 retired words including the client's UI strings), then typecheck `engine/` + `tools/`.
# The client suite is the other half of the contract and runs before a replace-all sync, not here:
# `npm --prefix game test` takes about a minute.
# Enable once with:  git config core.hooksPath .githooks

node --experimental-strip-types --disable-warning=ExperimentalWarning tools/verify.ts || {
  echo ""
  echo "pre-commit blocked: a cage or the doc linter failed."
  echo "Fix the numbers/data, run 'npm run verify', and commit again."
  exit 1
}

npx tsc --noEmit -p tsconfig.json || {
  echo ""
  echo "pre-commit blocked: typecheck failed."
  echo "Run 'npm run typecheck' for the file and line, fix it, and commit again."
  exit 1
}
