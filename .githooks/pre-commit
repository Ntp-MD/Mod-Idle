#!/bin/sh
# ModWorld pre-commit: run every cage + the cross-file linter.
# Enable once with:  git config core.hooksPath .githooks
node --experimental-strip-types --disable-warning=ExperimentalWarning tools/verify.ts || {
  echo ""
  echo "pre-commit blocked: a cage or the doc linter failed."
  echo "Fix the numbers/data, run 'npm run verify', and commit again."
  exit 1
}
